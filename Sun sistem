
<svg id=mysvg>
             <!--
              <circle id=earthorbit cx="200" cy="200" r="1??" stroke="darkgrey" fill="#0000" /> 
             -->
             <circle id=venusorbit   cx="200" cy="200" r="125" stroke="darkgrey" fill="#0000" />             
             <circle id=mercuryorbit cx="200" cy="200" r="75"  stroke="darkgrey" fill="#0000" />             

             <circle id=sun          cx="200" cy="200" r="40"  stroke="#FFFC"  stroke-width="6" fill="gold" />

              <circle id=mercury     cx="200" cy="275" r="10" fill="#800A" />
              <circle id=venus       cx="300" cy="275" r="15" fill="#880A" />

             <!-- Earth and Moon share this orbit around the Sun. -->
               <g id="earth-system">
                  <circle id=moonorbit cx="300" cy="75" r="30" stroke="darkgrey" fill="#0000" />
                  <circle id=earth cx="300" cy="75" r="15" fill="#0F88" />
                  <circle id=moon cx="300" cy="45" r="5" fill="#8888" />
               </g>
             
             <line x1=50  y1=10  x2=140 y2=50  stroke="blue"   stroke-width="6" />
             <line x1=30  y1=100 x2=300 y2=25  stroke="violet" stroke-width="6" />
</svg>

<style>
svg {
     width: 400px;
     height: 400px;
     background-color: #004C;
     cursor: pointer;
}

#sun {
      filter: drop-shadow(0 0 12px #ff8a00);
     }

#earth-system {
               /* Move Earth and Moon together around the Sun. */
               transform-origin: 200px 200px;
               transition: 8s linear;
}

 #moon {
        /* Rotate around Earth's position inside the moving system. */
        transform-origin: 300px 75px;
        transition: 8s linear;
       }

#mercury,
#venus {
        /* Use the Sun's center as the rotation point. */
        transform-origin: 200px 200px;
        transition: transform 8s linear;
       }

#mysvg:active #earth-system {
                             transform: rotate(360deg);
                            }

 #mysvg:active #moon       {
                            transform: rotate(720deg);
                           }

#mysvg:active #mercury {
                         transform: rotate(1440deg);
                       }

#mysvg:active #venus  {
                        transform: rotate(720deg);
                      }

/* Earth already rotates with #earth-system. */
</style>  
